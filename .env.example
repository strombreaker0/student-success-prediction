# Environment Configuration Template for Student Performance Prediction System
# Copy this file to .env and adjust values for your local or production deployment.

# ==============================================================================
# 1. CORE APPLICATION SECURITY
# ==============================================================================
# Secret key for cryptographically signing sessions and CSRF tokens.
# REQUIRED for production. Generate using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-hex-in-production-use-secrets-token-hex-32

# Flask environment ('production' for live deployment, 'development' for local debugging)
FLASK_ENV=production

# Cookie Security (set to 1 in production over HTTPS, 0 for local HTTP development)
SECURE_COOKIES=1

# Session inactivity timeout in minutes (default: 60)
SESSION_TIMEOUT_MINUTES=60

# ==============================================================================
# 2. DATABASE CONFIGURATION & PERSISTENCE
# ==============================================================================
# SQLite database file path:
# - Local default: database/student_success.db
# - Render Persistent Disk: /var/data/student_success.db (mount disk at /var/data)
STUDENT_DB_PATH=database/student_success.db

# ==============================================================================
# 3. INITIAL DEPLOYMENT BOOTSTRAPPING (OPTIONAL)
# ==============================================================================
# If deploying to a fresh environment with an empty database, setting these values
# allows the system to auto-provision an initial administrator on first boot.
# If not set, you can provision an admin via Render SSH / CLI: `flask create-admin`
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@institution.edu
ADMIN_PASSWORD=SetAStrongPassword123!
ADMIN_NAME=System Administrator

# ==============================================================================
# 4. DEMO ACCOUNTS CONFIGURATION (OPTIONAL OVERRIDES)
# ==============================================================================
# Demo Admin credentials for one-click "Continue as Admin Demo"
DEMO_ADMIN_USERNAME=demo_admin
DEMO_ADMIN_EMAIL=demo.admin@institution.edu
DEMO_ADMIN_PASSWORD=DemoAdmin#2026!
DEMO_ADMIN_NAME=Institutional Demo Administrator

# Demo Student credentials for one-click "Continue as Student Demo"
DEMO_STUDENT_USERNAME=demo_student
DEMO_STUDENT_EMAIL=demo.student@institution.edu
DEMO_STUDENT_PASSWORD=DemoStudent#2026!
DEMO_STUDENT_NAME=Demo Student Profile
DEMO_STUDENT_ID=STU_DEMO01

# ==============================================================================
# 5. SERVER & NETWORK
# ==============================================================================
# Web server listening port (Render sets $PORT automatically)
PORT=5000
